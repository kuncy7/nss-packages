Add kernel 6.12 support

Rebased onto the win.nss.1.1 ECM source (fafe228) from the original
6.12 support patch in qosmio/nss-packages, written for the
NHSS.QSDK.12.5 source:

- ip_route_output() grew a flow/dscp argument in 6.10
- sysctl proc handlers take const struct ctl_table since 6.10+,
  and ctl_table arrays are registered without sentinel entries
  (extended here to the handlers and tables that were added upstream
  after the original patch: RTP payload type tracker, accel denied
  list, defunct by MAC, mwan3, src_check_no_flush, PPE FSE, SFE
  MHT/tunnel fast-xmit)
- asm/unaligned.h moved to linux/unaligned.h (compat header)
- timer API and procfs adaptations in ecm_db

diff -Nur '--exclude=.git' ecm-base/Makefile ecm-test/Makefile
--- a/Makefile
+++ b/Makefile
@@ -562,4 +562,10 @@
 
 ccflags-y += -Wall -Werror
 
+# Kernel 6.12 compat headers
+ccflags-y += -I$(obj)/compat
+
+# GCC 15+ has stricter checks for prototypes and declarations. Silence them
+ccflags-y += -Wno-missing-prototypes -Wno-missing-declarations
+
 obj ?= .
diff -Nur '--exclude=.git' ecm-base/compat/asm/unaligned.h ecm-test/compat/asm/unaligned.h
--- a/compat/asm/unaligned.h
+++ b/compat/asm/unaligned.h
@@ -0,0 +1,13 @@
+/* Compatibility header for <asm/unaligned.h> moved to <linux/unaligned.h> in kernel 6.10+ */
+#ifndef _ASM_UNALIGNED_H
+#define _ASM_UNALIGNED_H
+
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,10,0)
+#include <linux/unaligned.h>
+#else
+#include_next <asm/unaligned.h>
+#endif
+
+#endif /* _ASM_UNALIGNED_H */
