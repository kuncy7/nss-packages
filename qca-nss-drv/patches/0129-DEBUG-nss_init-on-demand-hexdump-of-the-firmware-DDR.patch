+/*
+ * nss_memdump_handler()
+ *	E103: hexdump a window of the NSS firmware's DDR image on demand.
+ *
+ * The firmware's data segment lives in the reserved DDR region the core was
+ * loaded into.  That memory belongs to the host as much as to the NSS core,
+ * so it can be read even when the core is wedged and answers nothing - the
+ * same trick nss_fw_logbuffer_dump() uses for the log ring.  Used to take a
+ * postmortem of the wifili peer structures after the core dies on the first
+ * unicast exchange.
+ *
+ * dev.nss.general.memdump      = offset in bytes from the load address
+ * dev.nss.general.memdump_len  = how many bytes (capped at 4096)
+ */
+static int nss_memdump_handler(compat_const struct ctl_table *ctl, int write, void __user *buffer, size_t *lenp, loff_t *ppos)
+{
+	struct nss_ctx_instance *nss_ctx = &nss_top_main.nss[NSS_CORE_0];
+	uint32_t off, len;
+	void __iomem *base;
+	int ret;
+
+	ret = proc_dointvec(ctl, write, buffer, lenp, ppos);
+	if (ret || !write) {
+		return ret;
+	}
+
+	off = nss_cmd_buf.memdump;
+	len = nss_cmd_buf.memdump_len ? nss_cmd_buf.memdump_len : 256;
+	if (len > 4096) {
+		len = 4096;
+	}
+
+	base = ioremap(nss_ctx->load + off, len);
+	if (!base) {
+		nss_info_always("%px: memdump: cannot map 0x%x+0x%x\n",
+				nss_ctx, nss_ctx->load, off);
+		return ret;
+	}
+
+	nss_info_always("%px: NSS memdump at 0x%08x (load 0x%08x + 0x%x), %u bytes\n",
+			nss_ctx, nss_ctx->load + off, nss_ctx->load, off, len);
+	print_hex_dump(KERN_ERR, "nss-mem: ", DUMP_PREFIX_OFFSET, 32, 4,
+		       (void *)base, len, false);
+
+	iounmap(base);
+	return ret;
+}
